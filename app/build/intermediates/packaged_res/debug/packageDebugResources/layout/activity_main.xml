<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textViewToday"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="August 31, 2026"
        android:textColor="#666666"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/textViewUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="User:"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textViewProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="Progress: 0 / 0 completed today"
        android:textColor="#444444"
        android:textSize="16sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/linearLayoutCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewMon"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="Mon" />

            <TextView
                android:id="@+id/textViewTue"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="Tue" />

            <TextView
                android:id="@+id/textViewWed"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="Wed" />

            <TextView
                android:id="@+id/textViewThu"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="Thu" />

            <TextView
                android:id="@+id/textViewFri"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="Fri" />

            <TextView
                android:id="@+id/textViewSat"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:text="Sat" />

            <TextView
                android:id="@+id/textViewSun"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Sun" />

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/editTextHabit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Habit title"
                android:inputType="text"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/editTextDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Habit description"
                android:inputType="text"
                android:minHeight="48dp" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <Button
                android:id="@+id/buttonAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New Habit" />

            <Button
                android:id="@+id/buttonNewDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Day" />

            <Button
                android:id="@+id/buttonLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout" />

            <TextView
                android:id="@+id/textViewEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="No habits yet. Add your first habit!"
                android:textColor="#777777"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewToDo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="To Do"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewToDo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/textViewDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Done"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
